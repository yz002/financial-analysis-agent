# Connection string for the Render Postgres instance backing this service.
# Never commit a real value here -- this file is a placeholder template only.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Master Anthropic key used by /v1/ask's real run_agent call (Phase B session 3).
# Never commit a real value here.
ANTHROPIC_API_KEY=

# Required by src/data/edgar_client.py for every ticker-based tool call --
# EDGAR rejects requests without a descriptive "Name email" User-Agent.
SEC_USER_AGENT=

# Stripe (Phase B session 7b -- monetization amendment SS7). Test-mode values while
# developing; never commit a real value here. STRIPE_SECRET_KEY authenticates outbound
# API calls (Checkout Session creation, Subscription retrieval). STRIPE_WEBHOOK_SECRET
# verifies inbound webhook signatures (from the Stripe dashboard's webhook endpoint
# settings, or printed by `stripe listen` for local development). STRIPE_PRICE_ID is the
# $2/month recurring Price used by /v1/billing/checkout-session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
