# Connection string for the Render Postgres instance backing this service.
# Never commit a real value here -- this file is a placeholder template only.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Master Anthropic key used by /v1/ask's real run_agent call (Phase B session 3).
# Never commit a real value here.
ANTHROPIC_API_KEY=

# Required by src/data/edgar_client.py for every ticker-based tool call --
# EDGAR rejects requests without a descriptive "Name email" User-Agent.
SEC_USER_AGENT=
